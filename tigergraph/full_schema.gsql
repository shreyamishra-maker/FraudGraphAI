USE GRAPH FraudGraph
CREATE VERTEX Customer(PRIMARY_ID customer_id STRING, risk_score FLOAT);
CREATE VERTEX Card(PRIMARY_ID card_id STRING, card_type STRING, network STRING);
CREATE VERTEX Transaction(PRIMARY_ID transaction_id STRING, ts DATETIME, amount FLOAT, channel STRING, product STRING, risk_score FLOAT, billing_region STRING);
CREATE VERTEX DeviceProfile(PRIMARY_ID device_id STRING, device_info STRING, os STRING, browser STRING, screen STRING, proxy STRING, new_status STRING);
CREATE VERTEX EmailDomain(PRIMARY_ID domain STRING);
CREATE VERTEX BillingRegion(PRIMARY_ID region_id STRING);
CREATE VERTEX ClosedCase(PRIMARY_ID case_id STRING, customer_id STRING, outcome STRING, pattern STRING, exposure FLOAT, report_filed BOOL, analyst_notes STRING);
CREATE VERTEX InvestigationCase(PRIMARY_ID case_id STRING, customer_id STRING, status STRING, verdict STRING, probability FLOAT, pattern STRING, exposure FLOAT, summary STRING);
CREATE VERTEX Evidence(PRIMARY_ID evidence_id STRING, source STRING, claim STRING);
CREATE VERTEX Action(PRIMARY_ID action_id STRING, action STRING, route STRING, reason STRING, stage STRING);
CREATE DIRECTED EDGE OWNS(FROM Customer,TO Card);
CREATE DIRECTED EDGE MADE(FROM Card,TO Transaction);
CREATE DIRECTED EDGE FROM_DEVICE(FROM Transaction,TO DeviceProfile);
CREATE DIRECTED EDGE PURCHASER_EMAIL(FROM Transaction,TO EmailDomain);
CREATE DIRECTED EDGE BILLED_IN(FROM Transaction,TO BillingRegion);
CREATE DIRECTED EDGE NEXT(FROM Transaction,TO Transaction);
CREATE DIRECTED EDGE INVOLVES(FROM ClosedCase,TO Transaction);
CREATE DIRECTED EDGE ON_CARD(FROM ClosedCase,TO Card);
CREATE DIRECTED EDGE CONNECTED_TO(FROM ClosedCase,TO Card);
CREATE DIRECTED EDGE TRIGGERED(FROM Transaction,TO InvestigationCase);
CREATE DIRECTED EDGE SUPPORTED_BY(FROM InvestigationCase,TO Evidence);
CREATE DIRECTED EDGE SIMILAR_TO(FROM InvestigationCase,TO ClosedCase);
CREATE DIRECTED EDGE RECOMMENDS(FROM InvestigationCase,TO Action);
